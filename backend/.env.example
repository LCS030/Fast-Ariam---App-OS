# Copie para ".env" (na pasta backend/) e preencha. O arquivo .env NÃO deve ser versionado (está no .gitignore).
# Todos os valores abaixo são marcadores; nunca coloque segredos reais neste arquivo de exemplo.

# --- Obrigatórias ---
# Chave de assinatura do JWT. Gere uma aleatória e longa, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="troque-por-uma-chave-aleatoria-longa"

# PostgreSQL (Supabase em produção). Formato SQLAlchemy com o driver psycopg2: postgresql+psycopg2://
# Dev local, exemplo: postgresql+psycopg2://USUARIO:SENHA@localhost:5432/fast_ariam
DATABASE_URL="postgresql+psycopg2://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# --- Opcionais ---
# Ambiente: development (padrão) | test | production. Em production: CORS_ORIGINS é obrigatória,
# AUTO_CREATE_TABLES é recusada e resetar_banco.py não executa.
ENV="development"

# Algoritmo do JWT (somente HS256, HS384 ou HS512) e validade do token em minutos (padrão: 30).
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origens permitidas (CORS), separadas por vírgula, sem "*" (a API usa allow_credentials=True).
# Em dev, se vazia, usa localhost:3000/5173. OBRIGATÓRIA em produção, ex.: https://painel.seudominio.com.br
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# true cria as tabelas no startup (Base.metadata.create_all). Use SOMENTE em dev/teste; em produção use migrações.
AUTO_CREATE_TABLES="false"

# Usadas apenas por seed.py (primeiro administrador). Se SEED_ADMIN_PASSWORD ficar vazia, uma senha é gerada e exibida uma vez.
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_PASSWORD=""
