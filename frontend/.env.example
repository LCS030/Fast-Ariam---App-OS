# Copie para .env (ignorado pelo git) e ajuste. Variaveis EXPO_PUBLIC_* sao embutidas no
# bundle do app: NUNCA coloque segredos, chaves de servico ou credenciais aqui.

# URL base do servidor da API FastAPI (com ou sem o sufixo /api).
# - Producao/homologacao: use HTTPS, ex.: https://api.exemplo.com.br
# - Emulador Android: http://10.0.2.2:8000  (alias do host; so funciona no emulador)
# - Aparelho fisico na mesma rede: http://<IP-da-maquina>:8000
# Sem esta variavel, o app usa 10.0.2.2:8000 SOMENTE em desenvolvimento (__DEV__);
# em build de producao a API fica "nao configurada" e as chamadas falham com aviso.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
