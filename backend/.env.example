# Copie para ".env" (na pasta backend/) e preencha. O arquivo .env NÃO deve ser versionado (está no .gitignore).
# Todos os valores abaixo são marcadores; nunca coloque segredos reais neste arquivo de exemplo.

# --- Obrigatórias ---
# Chave de assinatura do JWT. Gere uma aleatória e longa, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="troque-por-uma-chave-aleatoria-longa"

# PostgreSQL (Supabase em produção). Formato SQLAlchemy com o driver psycopg2: postgresql+psycopg2://
# Dev local, exemplo: postgresql+psycopg2://USUARIO:SENHA@localhost:5432/fast_ariam
DATABASE_URL="postgresql+psycopg2://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# --- Opcionais ---
# Ambiente: development (padrão) | test | production. Em production: CORS_ORIGINS é obrigatória,
# AUTO_CREATE_TABLES é recusada e resetar_banco.py não executa.
ENV="development"

# Algoritmo do JWT (somente HS256, HS384 ou HS512) e validade do token em minutos (padrão: 30).
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origens permitidas (CORS), separadas por vírgula, sem "*" (a API usa allow_credentials=True).
# Em dev, se vazia, usa localhost:3000/5173. OBRIGATÓRIA em produção, ex.: https://painel.seudominio.com.br
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# true cria as tabelas no startup (Base.metadata.create_all). Use SOMENTE em dev/teste; em produção use migrações.
AUTO_CREATE_TABLES="false"

# Usadas apenas por seed.py (primeiro administrador). Se SEED_ADMIN_PASSWORD ficar vazia, uma senha é gerada e exibida uma vez.
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_PASSWORD=""

# --- Chaves de cifragem e integridade (OBRIGATORIAS; 32 bytes aleatorios em base64, uma para cada finalidade) ---
# Gere cada uma com: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# NUNCA reutilize entre si nem com a SECRET_KEY. Guarde um backup FORA do repositorio e do banco: sem a
# DATA_ENCRYPTION_KEY os dados cifrados nao podem ser recuperados.
DATA_ENCRYPTION_KEY="troque-por-32-bytes-aleatorios-em-base64"   # AES-256-GCM dos campos sensiveis
INDEX_KEY="troque-por-32-bytes-aleatorios-em-base64"             # HMAC do indice cego (busca por CNPJ)
INTEGRITY_KEY="troque-por-32-bytes-aleatorios-em-base64"         # HMAC do selo de integridade da visita

# Transicao da cifragem. Padrao FALSE: texto puro em coluna cifrada = erro (adulteracao). Use true so TEMPORARIAMENTE,
# fora de producao, enquanto houver linhas antigas a migrar com scripts/cifrar_dados_existentes.py. Em ENV=production
# true e recusado (a aplicacao nao inicia).
ENCRYPTION_ALLOW_LEGACY_PLAINTEXT="false"

# true => todo upload (app do tecnico e painel web) DEVE enviar o SHA-256 (campo "sha256") do arquivo; sem ele, 422
# HASH_AUSENTE. O servidor sempre calcula e grava o seu proprio hash. Use false apenas enquanto houver um app antigo
# (sem o envio de hash) em uso.
SHA256_ORIGEM_OBRIGATORIO="true"

# TLS ate o banco (PostgreSQL): require (padrao) | verify-ca | verify-full. Em producao prefira verify-full com o
# certificado raiz do provedor em DB_SSLROOTCERT. disable/allow/prefer so valem fora de producao (Postgres local).
DB_SSLMODE="require"
# DB_SSLROOTCERT="/caminho/para/ca.crt"

# --- Armazenamento de arquivos: Supabase Storage PRIVADO (fotos, comprovantes e assinaturas cifradas) ---
# Defina as DUAS variaveis juntas (ou nenhuma = disco local, so dev/teste; em ENV=production o Supabase e obrigatorio).
# SUPABASE_SERVICE_KEY ignora o RLS: fica SO aqui no backend, nunca no painel, no app, em log ou no Git.
# Painel do Supabase > Project Settings > API (chave de servico / secret key).
# SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# SUPABASE_SERVICE_KEY="cole-a-chave-de-servico-aqui"
# Bucket privado. dev e producao compartilham o projeto: use "fast-ariam-privado-dev" fora de producao.
# STORAGE_BUCKET="fast-ariam-privado"
